# Generated by Cargo
# will have compiled files and executables
/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# Cargo.lock often belongs in version control for binaries
# Cargo.lock

# These are backup files generated by rustc
**/*.rs.bk

# MSVC Windows builds of rustc generate these
*.pdb

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Optional: coverage / profiling
*.profraw
*.profdata
lcov.info
coverage/
